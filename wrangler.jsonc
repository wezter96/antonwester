{
  // antonwester.se on Cloudflare Workers, deployed by .github/workflows/deploy.yml: static assets, and worker/index.js for /api/*
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antonwester",
  "account_id": "bf20e985c7cc69a7e1ec289ce878b494",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "routes": [{ "pattern": "antonwester.se/*", "zone_name": "antonwester.se" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // every other path is served from the assets without running the Worker
    "run_worker_first": ["/api/*"]
  },
  // MAIL_TO, the verified Email Routing address the form mails, is a secret: wrangler secret put MAIL_TO
  "send_email": [{ "name": "MAIL" }],
  "ratelimits": [
    { "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "CHAT_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Workers AI answers the site chat (worker/chat.js), so no outside API keys
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
