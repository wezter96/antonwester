---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { LOCALES, SITE_URL, ogPath, pathFor, type PageRef } from '../content/routes';
import { ui } from '../content/ui';
import type { HeadProps } from '../lib/seo';

const home: PageRef = { kind: 'home' };
const head: HeadProps = {
  title: '404 | Anton Wester',
  description: 'Sidan finns inte, länken kan vara gammal eller felstavad. The page does not exist; the link may be old or mistyped. Gå till startsidan.',
  locale: 'sv',
  canonical: `${SITE_URL}/404.html`,
  alternates: [],
  ogImage: `${SITE_URL}${ogPath(home, 'sv')}`,
  ogImageAlt: 'Anton Wester, AI-konsult i Göteborg',
  jsonLd: [],
  noindex: true,
};
---
<Base head={head}>
  <Nav locale="sv" page={home} standalone />
  <main id="main" class="nf grid" data-ground="fog">
    <p class="code" aria-hidden="true">404</p>
    {LOCALES.map((l, i) => {
      const t = ui[l].notFound;
      const Heading = i === 0 ? 'h1' : 'h2';
      return (
        <div class="half" lang={l}>
          <Heading class="sub">{t.title}</Heading>
          <p class="lead">{t.body}</p>
          <a class="lnk" href={pathFor(home, l)}>{t.home}</a>
        </div>
      );
    })}
  </main>
  <Footer locale="sv" page={home} />
</Base>

<style>
  .nf { min-height: 80svh; align-content: end; row-gap: 32px; padding: clamp(120px, 14vw, 220px) var(--margin) clamp(64px, 8vw, 140px); }
  .code { grid-column: 1 / -1; font-size: clamp(6rem, 30vw, 28rem); line-height: .8; font-weight: 800; font-stretch: 62%; letter-spacing: -.03em; }
  .half { grid-column: span 6; display: grid; justify-items: start; gap: 16px; }
  @media (max-width: 760px) { .half { grid-column: 1 / -1; } }
</style>
