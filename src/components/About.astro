---
import Portrait from './Portrait.astro';
import { home } from '../content/home';
import type { Locale } from '../content/routes';
import { site } from '../content/site';
import { ui } from '../content/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = home[locale];
const t = ui[locale];
// Anton supplies src/assets/portrait.*; until then the bio takes the full width instead of a placeholder
const hasPortrait = Object.keys(import.meta.glob('../assets/portrait.{jpg,jpeg,png,webp}')).length > 0;
---
<section id="about" class="about grid" data-ground="fog">
  {hasPortrait && <div class="pic"><Portrait locale={locale} /></div>}
  <div class:list={['body', { solo: !hasPortrait }]}>
    <h2 class="head">{c.aboutHeading}</h2>
    <div class="bio">{c.bio.map((p) => <p class="lead">{p}</p>)}</div>
    <h3 class="sub skills-h">{c.expertise.heading}</h3>
    <ul class="skills">
      {c.expertise.items.map((i) => <li><b>{i.name}</b><span>{i.detail}</span></li>)}
    </ul>
    <table>
      <caption class="sr-only">{locale === 'sv' ? 'Erfarenhet' : 'Experience'}</caption>
      <tbody>
        {c.experience.map((r) => <tr><td class="years">{r.years}</td><td>{r.role}</td><td class="org">{r.org}</td></tr>)}
      </tbody>
    </table>
    <p class="stack">{c.stack}</p>
    <p class="links">
      <a class="lnk" href={site.linkedin} rel="noopener">LinkedIn</a>
      <a class="lnk" href={site.github} rel="noopener">GitHub</a>
      <a class="lnk" href={site.cv} download>{t.footer.cv}</a>
    </p>
  </div>
</section>

<style>
  .about { padding: var(--section) var(--margin); row-gap: 40px; align-items: start; }
  .pic { grid-column: 1 / 6; }
  .body { grid-column: 7 / 13; }
  .body.solo { grid-column: 1 / 10; }
  .body h2 { margin-bottom: 28px; }
  .bio { display: grid; gap: 16px; max-width: 48ch; }
  .skills-h { margin-top: clamp(40px, 4vw, 64px); }
  .skills { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px var(--gutter); }
  .skills li { display: grid; gap: 4px; align-content: start; }
  .skills b { font-weight: 700; }
  .skills span { color: var(--soft); }
  table { width: 100%; border-collapse: collapse; margin: 36px 0 28px; }
  td { padding: 11px 12px; vertical-align: top; }
  tr:nth-child(odd) td { background: var(--gs); }
  .years { white-space: nowrap; width: 1%; color: var(--soft); font-variant-numeric: tabular-nums; }
  td { overflow-wrap: break-word; }
  .org { font-weight: 700; text-align: right; }
  .stack { max-width: 60ch; color: var(--soft); }
  .links { display: flex; gap: 24px; margin-top: 24px; flex-wrap: wrap; }
  @media (max-width: 1000px) { .pic, .body, .body.solo { grid-column: 1 / -1; } }
  @media (max-width: 640px) {
    .skills { grid-template-columns: 1fr; }
    /* one row per job: years and employer on top, the role under them */
    tr { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; padding: 12px; }
    tr:nth-child(odd) { background: var(--gs); }
    td, tr:nth-child(odd) td { padding: 0; background: none; }
    .years { width: auto; }
    td:not(.years):not(.org) { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
