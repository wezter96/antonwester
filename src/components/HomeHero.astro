---
import LogoBar from './LogoBar.astro';
import Monument from './Monument.astro';
import { home } from '../content/home';
import type { Locale } from '../content/routes';
import { site } from '../content/site';
import { ui } from '../content/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
const c = home[locale];
---
<section class="hero" data-ground="fog">
  <h1 class="h1">
    <Monument words={['Anton', 'Wester']} portrait as="div" locale={locale} />
    <span class="sr-only">, </span>
    <span class="tail">{c.h1Tail}</span>
  </h1>
  <div class="hfoot grid">
    <p class="offer">{c.offer}</p>
    <div class="actions">
      <a class="lnk" href="#scan">{t.estimate}</a>
      <a class="btn" href={site.booking} rel="noopener">{t.book}</a>
    </div>
  </div>
  <LogoBar locale={locale} />
</section>

<style>
  .hero {
    display: grid; min-height: 100svh; overflow: hidden;
    grid-template-rows: 1fr auto auto auto; grid-template-areas: "name" "tail" "foot" "axis";
    padding-top: clamp(72px, 7vw, 104px);
  }
  .h1 { display: contents; }
  .hero :global(.monument-area) { grid-area: name; align-self: center; padding-block: clamp(24px, 4vw, 64px); }
  .tail { grid-area: tail; padding-inline: var(--margin); font-size: var(--step-lead); line-height: 1.35; font-weight: 700; }
  .hfoot { grid-area: foot; padding: 2px var(--margin) clamp(24px, 3vw, 44px); align-items: end; }
  .offer { grid-column: 1 / 8; font-size: var(--step-lead); line-height: 1.35; max-width: 46ch; }
  .actions { grid-column: 8 / 13; display: flex; justify-content: flex-end; align-items: center; gap: clamp(16px, 2.2vw, 32px); flex-wrap: wrap; }
  .hero :global(.axis) { grid-area: axis; }
  .tail, .offer, .actions { transition: opacity .8s ease, transform 1s var(--ease-out); }
  .tail { transition-delay: .9s; }
  .offer { transition-delay: .95s; }
  .actions { transition-delay: 1.08s; }
  :global(.pre) .tail, :global(.pre) .offer, :global(.pre) .actions { opacity: 0; transform: translateY(12px); }
  @media (max-width: 900px) {
    .offer, .actions { grid-column: 1 / -1; }
    .actions { justify-content: flex-start; margin-top: 20px; }
  }
</style>
