---
import LogoBar from './LogoBar.astro';
import Monument from './Monument.astro';
import { home } from '../content/home';
import type { Locale } from '../content/routes';
import { site } from '../content/site';
import { ui } from '../content/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
const c = home[locale];
---
<section class="hero" data-ground="fog">
  <Monument words={['Anton', 'Wester']} spaceEm={0.95} as="div" decorative />
  <div class="hfoot grid">
    <div class="lede">
      <h1 class="h1"><span class="sr-only">Anton Wester, </span><strong class="tail">{c.h1Tail}</strong></h1>
      <p class="offer">{c.offer}</p>
    </div>
    <div class="actions">
      <a class="lnk" href="#scan">{t.estimate}</a>
      <a class="btn" href={site.booking} rel="noopener">{t.book}</a>
    </div>
  </div>
  <LogoBar locale={locale} />
</section>

<style>
  .hero {
    display: grid; min-height: 100svh; overflow: hidden;
    grid-template-rows: 1fr auto auto; grid-template-areas: "name" "foot" "axis";
    padding-top: clamp(72px, 7vw, 104px);
  }
  .hero :global(.monument-area) { grid-area: name; align-self: center; padding-block: clamp(24px, 4vw, 64px); }
  .hfoot { grid-area: foot; padding: 2px var(--margin) clamp(24px, 3vw, 44px); align-items: end; }
  /* the h1 tail runs in as the bold start of the offer sentence */
  .lede { grid-column: 1 / 8; font-size: var(--step-lead); line-height: 1.35; max-width: 50ch; }
  .h1, .offer { display: inline; font-size: inherit; line-height: inherit; font-weight: inherit; }
  .tail { font-weight: 700; }
  .actions { grid-column: 8 / 13; display: flex; justify-content: flex-end; align-items: center; gap: clamp(16px, 2.2vw, 32px); flex-wrap: wrap; }
  .hero :global(.axis) { grid-area: axis; }
  .lede, .actions { transition: opacity .8s ease, transform 1s var(--ease-out); }
  .lede { transition-delay: .95s; }
  .actions { transition-delay: 1.08s; }
  :global(.pre) .lede, :global(.pre) .actions { opacity: 0; transform: translateY(12px); }
  @media (max-width: 900px) {
    .lede, .actions { grid-column: 1 / -1; }
    .actions { justify-content: flex-start; margin-top: 20px; }
  }
</style>
