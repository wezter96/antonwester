---
import { home } from '../content/home';
import { pathFor, type Locale } from '../content/routes';

interface Props { locale: Locale }
const { locale } = Astro.props;
const stages = home[locale].approach;
---
<section id="approach" class="approach grid" data-ground="fog">
  <h2 class="sr-only">{locale === 'sv' ? 'Arbetssätt' : 'Approach'}</h2>
  {stages.map((s) => (
    <>
      <p class="stage" style={`--wd:${s.wdth}`}>{s.word}</p>
      <p class="copy">
        <b>{s.lead}</b> {s.body}
        <span class="links">
          <a class="lnk" href={pathFor({ kind: 'service', id: s.service }, locale)}>{s.linkLabel}</a>
          {s.more?.map((m) => <a class="lnk" href={pathFor({ kind: 'service', id: m.service }, locale)}>{m.label}</a>)}
        </span>
      </p>
    </>
  ))}
</section>

<style>
  .approach { padding: var(--section) var(--margin); row-gap: clamp(32px, 4.2vw, 64px); align-items: baseline; }
  .stage { grid-column: 1 / 7; font-size: var(--step-head); line-height: .9; font-weight: 800; letter-spacing: -.03em; font-variation-settings: 'wdth' var(--wd); }
  .copy { grid-column: 7 / 12; font-size: var(--step-lead); line-height: 1.4; max-width: 42ch; }
  .copy b { font-weight: 700; }
  .copy .links { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 5px; font-size: var(--step-body); }
  @media (max-width: 800px) {
    .stage, .copy { grid-column: 1 / -1; }
    /* the link closes its own stage, so it sits well clear of the next stage word */
    .copy { margin-bottom: clamp(48px, 12vw, 80px); }
  }
</style>
