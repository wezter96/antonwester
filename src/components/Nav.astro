---
import Monogram from './Monogram.astro';
import { otherLocale, pathFor, type Locale, type PageRef } from '../content/routes';
import { site } from '../content/site';
import { ui } from '../content/ui';

const { locale, page, standalone = false } = Astro.props;
const t = ui[locale];
const home = pathFor({ kind: 'home' }, locale);
const prefix = page.kind === 'home' && !standalone ? '' : home;
const hrefFor = (id: string) => (id === 'contact' && !standalone ? '#contact' : `${prefix}#${id}`);
const other = otherLocale(locale);
const links = [
  ['work', t.nav.work],
  ['approach', t.nav.approach],
  ['about', t.nav.about],
  ['contact', t.nav.contact],
] as const;
---
<header class="nav">
  <a class="mark" href={home}><Monogram /><span>Anton Wester</span></a>
  <!-- on small screens the booking button and the menu button sit on the right, where the thumb is; the menu is a popover, so it opens without JS -->
  <a class="btn bar-cta" href={site.booking} rel="noopener">{t.bookShort}</a>
  <button class="toggle" type="button" popovertarget="menu" aria-label={t.menu}><span class="burger" aria-hidden="true"></span></button>
  <nav id="menu" popover aria-label={t.navLabel}>
    <ul>
      {links.map(([id, label], i) => <li style={`--i:${i}`}><a href={hrefFor(id)}>{label}</a></li>)}
      <li style={`--i:${links.length}`}><a data-lang-switch href={pathFor(page, other)} hreflang={other} lang={other}>{t.switchLabel}</a></li>
    </ul>
    <a class="btn cta" href={site.booking} rel="noopener">{t.bookShort}</a>
  </nav>
</header>

<script>
  // an in-page link scrolls under the open menu, so it closes first
  const menu = document.getElementById('menu');
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a') && menu.matches(':popover-open')) menu.hidePopover();
  });

  // the bar slides away while you scroll down and comes back as soon as you scroll up, as on SökHem
  const bar = document.querySelector<HTMLElement>('header.nav');
  // iOS scrolls the page itself to lift a focused field above the keyboard and back when it goes; those scrolls do not count
  const raisesKeyboard = (el: Element | null) =>
    el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement ||
    (el instanceof HTMLInputElement && !['button', 'checkbox', 'radio', 'submit', 'hidden', 'range', 'file'].includes(el.type));
  let lastY = scrollY;
  let queued = 0;
  let keyboardSettlesAt = 0;
  document.addEventListener('focusout', (e) => { if (raisesKeyboard(e.target as Element)) keyboardSettlesAt = performance.now() + 500; });
  addEventListener('scroll', () => {
    if (queued) return;
    queued = requestAnimationFrame(() => {
      queued = 0;
      const delta = scrollY - lastY;
      lastY = scrollY;
      if (!bar || raisesKeyboard(document.activeElement) || performance.now() < keyboardSettlesAt) return;
      if (scrollY < 80 || menu?.matches(':popover-open') || delta < -1) delete bar.dataset.hidden;
      else if (delta > 1) bar.dataset.hidden = '';
    });
  }, { passive: true });
</script>

<style>
  .nav {
    position: fixed; z-index: 5; top: 0; left: 0; right: 0; padding: clamp(14px, 2vw, 28px) var(--margin);
    /* the ground follows the section in view, so the bar always matches the page under it */
    background: var(--ground); color: var(--fg);
    display: flex; justify-content: space-between; align-items: center; gap: 24px; font-weight: 500;
    transition: opacity .8s ease .2s, transform .4s var(--ease-in-out);
  }
  :global(.pre) .nav { opacity: 0; }
  /* a keyboard user tabbing into the bar always sees it */
  .nav[data-hidden]:not(:focus-within) { transform: translateY(-100%); }
  .mark { display: inline-flex; align-items: center; gap: .6em; font-weight: 700; font-stretch: 112%; text-decoration: none; min-height: 44px; }
  a { text-decoration: none; }
  ul { list-style: none; margin: 0; padding: 0; }
  ul a { position: relative; display: inline-flex; align-items: center; min-height: 44px; }
  ul a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 10px; height: .09em; background: currentColor;
    transform: scaleX(0); transform-origin: 0 50%; transition: transform .35s var(--ease-in-out);
  }
  ul a:hover::after, ul a:focus-visible::after { transform: none; }

  @media (min-width: 901px) {
    .toggle, .bar-cta { display: none; }
    /* the popover stays in the bar on wide screens */
    #menu {
      display: flex; align-items: center; gap: clamp(20px, 2.6vw, 40px);
      position: static; inset: auto; margin: 0; padding: 0; border: 0; overflow: visible; width: auto; height: auto;
      background: none; color: inherit;
    }
    ul { display: flex; gap: clamp(16px, 2.4vw, 36px); }
    .cta { min-height: 44px; padding: .6rem 1.15rem; }
  }

  @media (max-width: 900px) {
    .nav { gap: 12px; }
    .bar-cta { margin-left: auto; min-height: 44px; padding: .55rem 1rem; }
    .toggle { position: relative; width: 44px; height: 44px; margin-right: -10px; padding: 0; background: none; border: 0; color: inherit; cursor: pointer; -webkit-tap-highlight-color: transparent; }
    /* three lines; the outer two turn into a cross while the menu is open */
    .burger, .burger::before, .burger::after {
      position: absolute; left: 11px; width: 22px; height: 2px; background: currentColor; border-radius: 1px;
      transition: transform .35s var(--ease-in-out), opacity .2s;
    }
    .burger { top: 21px; }
    .burger::before, .burger::after { content: ''; left: 0; }
    .burger::before { transform: translateY(-7px); }
    .burger::after { transform: translateY(7px); }
    .nav:has(#menu:popover-open) .burger { background: transparent; }
    .nav:has(#menu:popover-open) .burger::before { transform: rotate(45deg); }
    .nav:has(#menu:popover-open) .burger::after { transform: rotate(-45deg); }

    /* the menu drops down from the bar; @starting-style gives it a first frame to animate from, and allow-discrete keeps it on screen while it closes */
    #menu {
      position: fixed; inset: calc(44px + 2 * clamp(14px, 2vw, 28px)) 0 auto; margin: 0; width: 100%; border: 0;
      padding: 8px var(--margin) 32px; background: var(--ground); color: var(--fg);
      opacity: 0; transform: translateY(-12px); clip-path: inset(0 0 100% 0);
      transition: opacity .3s, transform .4s var(--ease-out), clip-path .4s var(--ease-out), overlay .4s allow-discrete, display .4s allow-discrete;
    }
    #menu:popover-open { display: grid; gap: 20px; opacity: 1; transform: none; clip-path: inset(0); }
    #menu::backdrop {
      top: calc(44px + 2 * clamp(14px, 2vw, 28px)); background: rgb(12 30 34 / 0);
      transition: background-color .3s, overlay .4s allow-discrete, display .4s allow-discrete;
    }
    #menu:popover-open::backdrop { background: rgb(12 30 34 / .4); }
    li { opacity: 0; transform: translateY(-6px); transition: opacity .3s, transform .35s var(--ease-out); }
    #menu:popover-open li { opacity: 1; transform: none; transition-delay: calc(60ms + var(--i) * 35ms); }
    @starting-style {
      #menu:popover-open { opacity: 0; transform: translateY(-12px); clip-path: inset(0 0 100% 0); }
      #menu:popover-open::backdrop { background: rgb(12 30 34 / 0); }
      #menu:popover-open li { opacity: 0; transform: translateY(-6px); }
    }
    ul { display: grid; font-size: var(--step-lead); font-weight: 650; }
    /* the bar has its own booking button on small screens */
    #menu .cta { display: none; }
  }
  /* the name gives way to the booking button on the narrowest phones */
  @media (max-width: 380px) {
    .mark span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
</style>
