---
import Monogram from './Monogram.astro';
import { otherLocale, pathFor, type Locale, type PageRef } from '../content/routes';
import { ui } from '../content/ui';

interface Props { locale: Locale; page: PageRef }
const { locale, page } = Astro.props;
const t = ui[locale];
const home = pathFor({ kind: 'home' }, locale);
const prefix = page.kind === 'home' ? '' : home;
const other = otherLocale(locale);
const links = [
  ['work', t.nav.work],
  ['approach', t.nav.approach],
  ['about', t.nav.about],
  ['contact', t.nav.contact],
] as const;
---
<header class="nav">
  <a class="mark" href={home}><Monogram /><span>Anton Wester</span></a>
  <nav aria-label={t.navLabel}>
    <ul>
      {links.map(([id, label]) => <li class={id === 'contact' ? 'keep' : ''}><a href={`${prefix}#${id}`}>{label}</a></li>)}
      <li class="keep"><a data-lang-switch href={pathFor(page, other)} hreflang={other} lang={other}>{t.switchLabel}</a></li>
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: absolute; z-index: 5; top: clamp(14px, 2vw, 28px); left: var(--margin); right: var(--margin);
    display: flex; justify-content: space-between; align-items: center; gap: 24px; font-weight: 500;
    transition: opacity .8s ease .2s;
  }
  :global(.pre) .nav { opacity: 0; }
  .mark { display: inline-flex; align-items: center; gap: .6em; font-weight: 700; font-stretch: 112%; text-decoration: none; min-height: 44px; }
  ul { display: flex; gap: clamp(16px, 2.4vw, 36px); list-style: none; margin: 0; padding: 0; }
  a { text-decoration: none; }
  ul a { position: relative; display: inline-flex; align-items: center; min-height: 44px; }
  ul a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 10px; height: .09em; background: currentColor;
    transform: scaleX(0); transform-origin: 0 50%; transition: transform .35s var(--ease-in-out);
  }
  ul a:hover::after, ul a:focus-visible::after { transform: none; }
  @media (max-width: 760px) {
    .mark span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    li:not(.keep) { display: none; }
  }
</style>
