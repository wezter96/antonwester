---
import type { Locale } from '../content/routes';
import { site } from '../content/site';
import { ui } from '../content/ui';

interface Props { locale: Locale; inquiry?: string }
const { locale, inquiry } = Astro.props;
const t = ui[locale];
const c = t.contact;
---
<section id="contact" class="close grid" data-ground="tint">
  <div class="intro">
    <h2 class="head">{c.heading}</h2>
    <p class="row">
      <a class="btn" href={site.booking} rel="noopener">{t.book}</a>
      <a class="mail lnk" href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <p class="avail"><span class="dot" aria-hidden="true"></span>{c.availability}</p>
  </div>
  <form
    data-contact
    method="POST"
    action={site.formAction}
    data-ajax={site.formAjax}
    data-sending={c.sending}
    data-success={c.success}
    data-error={c.error}
    data-submit={c.submit}
  >
    <p class="form-h">{c.formHeading}</p>
    <input type="hidden" name="estimate" value="" />
    <div class="hp" aria-hidden="true">
      <label>Leave empty<input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>
    </div>
    <label>{c.fields.name}<input name="name" autocomplete="name" placeholder={c.placeholders.name} required /></label>
    <label>{c.fields.email}<input name="email" type="email" autocomplete="email" placeholder={c.placeholders.email} required /></label>
    <label>{c.fields.company}<input name="company" autocomplete="organization" placeholder={c.placeholders.company} /></label>
    <label>{c.fields.inquiry}
      <select name="inquiry">
        {c.inquiries.map((o) => <option value={o} selected={o === inquiry}>{o}</option>)}
      </select>
    </label>
    <label class="full">{c.fields.message}<textarea name="message" rows="6" placeholder={c.placeholders.message} required></textarea></label>
    <div class="submit">
      <button class="btn" type="submit">{c.submit}</button>
      <p class="status" data-form-status aria-live="polite"></p>
    </div>
  </form>
</section>

<script>
  import '../scripts/form';
</script>

<style>
  .close { padding: var(--section) var(--margin); row-gap: clamp(48px, 6vw, 96px); align-items: start; }
  .intro { grid-column: 1 / 7; }
  .row { display: flex; align-items: center; gap: clamp(20px, 3vw, 48px); flex-wrap: wrap; margin-top: clamp(24px, 3.4vw, 48px); }
  .mail { font-size: var(--step-sub); font-weight: 600; }
  .avail { margin-top: 20px; color: var(--soft); display: flex; align-items: center; gap: 10px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 1px color-mix(in srgb, var(--fg) 25%, transparent); }
  form { grid-column: 8 / 13; display: grid; grid-template-columns: 1fr 1fr; gap: 24px var(--gutter); }
  .form-h { grid-column: 1 / -1; font-size: var(--step-lead); font-weight: 700; }
  label { display: grid; gap: 8px; font-weight: 600; }
  .full { grid-column: 1 / -1; }
  input, select, textarea {
    width: 100%; background: transparent; border: 0; border-bottom: 1px solid var(--soft); border-radius: 0;
    padding: 10px 0; color: var(--fg); font-weight: 400; min-height: 44px;
  }
  select option { color: #0C1E22; }
  input::placeholder, textarea::placeholder { color: var(--soft); }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--signal); outline-offset: 4px; }
  textarea { min-height: 140px; resize: vertical; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; } /* taste-skill-ignore: off-screen honeypot box, not a rule */
  .submit { grid-column: 1 / -1; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .status { color: var(--soft); min-height: 1.5em; }
  .status[data-state='error'] { color: var(--hot); }
  @media (max-width: 900px) { .intro, form { grid-column: 1 / -1; } }
  @media (max-width: 640px) { form { grid-template-columns: 1fr; } }
</style>
