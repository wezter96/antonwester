---
import { pathFor, type Locale } from '../content/routes';
import { site } from '../content/site';
import { ui } from '../content/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
const c = t.booking;
const f = t.contact;
const config = JSON.stringify({ locale, siteKey: site.turnstileSiteKey, t: c });
const mail = `mailto:${site.email}`;
---
<section class="book" data-ground="fog2" data-booking data-config={config}>
  <p class="nojs">{c.noJs} <a class="lnk" href={mail}>{site.email}</a></p>

  <div class="app" data-app>
    <div class="bar">
      <button class="step" type="button" data-prev>‹ {c.prev}</button>
      <h2 class="week" data-week tabindex="-1"></h2>
      <button class="step" type="button" data-next>{c.next} ›</button>
    </div>
    <div class="days" data-days aria-busy="true"></div>
    <p class="status" data-status role="status"></p>
    <p class="zone" data-zone></p>

    <form data-form hidden>
      <h3 class="chosen sub" data-chosen tabindex="-1"></h3>
      <input type="hidden" name="start" />
      <input type="hidden" name="locale" value={locale} />
      <div class="hp" aria-hidden="true">
        <label>Leave empty<input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>
      </div>
      <label>{f.fields.name}<input name="name" autocomplete="name" placeholder={f.placeholders.name} required /></label>
      <label>{f.fields.email}<input name="email" type="email" autocomplete="email" placeholder={f.placeholders.email} required /></label>
      <label>{f.fields.company}<input name="company" autocomplete="organization" placeholder={f.placeholders.company} /></label>
      <label class="full">{c.fields.message}<textarea name="message" rows="4" placeholder={c.placeholders.message} required></textarea></label>
      <div class="full" data-turnstile></div>
      <p class="full privacy">{c.privacy}</p>
      <div class="full submit">
        <button class="btn" type="submit">{c.submit}</button>
        <p class="status" data-form-status aria-live="polite"></p>
      </div>
    </form>
  </div>

  <div aria-live="polite">
    <div class="done" data-booked tabindex="-1" hidden>
      <h2 class="sub">{c.booked}</h2>
      <p class="lead" data-booked-time></p>
      <p>{c.bookedBody}</p>
    </div>
    <p class="down" data-down hidden>
      {c.down} <a class="lnk" href={mail}>{site.email}</a> <a class="lnk" href={`${pathFor({ kind: 'home' }, locale)}#contact`}>{c.downLink}</a>.
    </p>
  </div>
</section>

<script>
  import '../scripts/booking';
</script>

<style>
  .book { padding: var(--section) var(--margin); display: grid; gap: 24px; }
  /* no JS: the page offers the address and hides the calendar it cannot fill */
  :global(.js) .nojs, :global(html:not(.js)) .app { display: none; }
  .app { display: grid; gap: 16px; }
  .app[hidden] { display: none; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .week { font-size: var(--step-lead); font-weight: 700; text-align: center; }
  .week:focus { outline: none; }
  .step { min-height: 44px; padding: 0; background: none; border: 0; color: var(--fg); font-weight: 600; cursor: pointer; }
  .step:hover:not([aria-disabled='true']) { text-decoration: underline; text-underline-offset: .2em; }
  .step[aria-disabled='true'] { color: var(--soft); cursor: default; }

  /* columns follow the data: five days, or six when a far time zone adds one */
  .days { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: var(--gutter); min-height: 180px; align-content: start; }
  .days :global(h3) { padding-bottom: 8px; border-bottom: 2px solid var(--alt-gs); margin-bottom: 8px; font-size: 1rem; font-weight: 700; }
  .days :global(.wd) { text-transform: capitalize; display: block; }
  .days :global(small) { display: block; color: var(--soft); font-weight: 400; font-size: .875rem; }
  .days :global(.none) { color: var(--soft); font-size: .875rem; text-align: center; padding-top: 8px; }
  .days :global(.t) {
    display: block; width: 100%; min-height: 44px; margin-bottom: 6px; padding: 8px 4px; text-align: center;
    background: none; border: 1px solid var(--alt-gs); color: var(--fg); cursor: pointer; transition: border-color .2s;
  }
  .days :global(.t:hover) { border-color: var(--fg); }
  .days :global(.t[aria-pressed='true']) { background: var(--signal); border-color: var(--signal); color: var(--ink); font-weight: 700; }

  .status { color: var(--soft); min-height: 1.5em; }
  .status[data-state='error'] { color: var(--hot); }
  .zone, .privacy { color: var(--soft); font-size: .875rem; }

  form { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px var(--gutter); padding-top: 24px; border-top: 2px solid var(--rule); }
  form[hidden] { display: none; }
  .chosen { grid-column: 1 / -1; scroll-margin-top: 96px; }
  .chosen:focus { outline: none; }
  .chosen::first-letter { text-transform: uppercase; }
  label { display: grid; gap: 8px; font-weight: 600; }
  .full { grid-column: 1 / -1; }
  input, textarea {
    width: 100%; background: transparent; border: 0; border-bottom: 1px solid var(--soft); border-radius: 0;
    padding: 10px 0; color: var(--fg); font-weight: 400; min-height: 44px;
  }
  input::placeholder, textarea::placeholder { color: var(--soft); }
  input:focus-visible, textarea:focus-visible { outline: 2px solid var(--signal); outline-offset: 4px; }
  textarea { min-height: 112px; resize: vertical; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; } /* taste-skill-ignore: off-screen honeypot box, not a rule */
  .submit { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .done { display: grid; gap: 12px; max-width: 62ch; }
  .done[hidden] { display: none; }
  .done:focus { outline: none; }
  .done .lead::first-letter { text-transform: uppercase; }
  @media (max-width: 640px) {
    .days { grid-auto-flow: row; min-height: 320px; }
    /* a stacked day reads as one line of times, and a day with none takes little room */
    .days :global(.day) { display: flex; flex-wrap: wrap; gap: 6px; }
    .days :global(h3) { flex: 0 0 100%; margin-bottom: 2px; }
    .days :global(h3 .wd), .days :global(h3 small) { display: inline; }
    .days :global(h3 small) { margin-left: .5em; }
    .days :global(.t) { flex: 0 0 calc(25% - 4.5px); width: auto; margin: 0; }
    .days :global(.none) { padding: 0; }
    form { grid-template-columns: 1fr; }
  }
</style>
