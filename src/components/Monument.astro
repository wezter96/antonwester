---
import { lineSizeVw, MONUMENT, type Setting } from '../lib/measure';

interface Props {
  words: string[];
  /** Width in em of an empty space between the first and second word, on top of the gap. */
  spaceEm?: number;
  as?: 'h1' | 'p' | 'div';
  tail?: string;
  /** Hide the whole name from assistive tech, for when the page states it elsewhere. */
  decorative?: boolean;
  setting?: Setting;
  targetVw?: number;
  gapEm?: number;
}
const { words, spaceEm = 0, as: Tag = 'h1', tail, decorative = false, setting = MONUMENT, targetVw = 82, gapEm = 0.12 } = Astro.props;
const desktop = lineSizeVw(spaceEm ? [words[0], spaceEm, ...words.slice(1)] : words, targetVw, gapEm, setting);
const longest = words.reduce((a, b) => (b.length > a.length ? b : a));
const mobile = lineSizeVw([longest], 88, 0, setting);
let index = 0;
const letters = words.map((w) => [...w].map((ch) => ({ ch, delay: index++ * 55 })));
---
<div
  class="monument-area"
  data-monument-area
  aria-hidden={decorative ? 'true' : undefined}
  style={`--mono-d:${desktop}vw;--mono-m:${mobile}vw;--mono-wdth:${setting.wdth};--mono-track:${setting.tracking}em;--mono-gap:${gapEm}em;--mono-space:${spaceEm}em`}
>
  <Tag class="monument" data-monument>
    <span class="line" aria-hidden="true">
      {letters.map((word, wi) => (
        <>
          {wi === 1 && spaceEm > 0 && <span class="space" />}
          <span class="word">{word.map(({ ch, delay }) => <span class="ch" data-letter style={`transition-delay:${delay}ms`}>{ch}</span>)}</span>
        </>
      ))}
    </span>
    {!decorative && <span class="sr-only">{words.join(' ')}</span>}
    {tail && <><span class="sr-only">, </span><span class="tail">{tail}</span></>}
  </Tag>
</div>

<style>
  .monument-area { touch-action: pan-y; }
  .monument { margin: 0; font-weight: 800; text-transform: uppercase; letter-spacing: var(--mono-track); line-height: .8; font-size: inherit; }
  .line { display: flex; justify-content: center; align-items: baseline; gap: var(--mono-gap); font-size: var(--mono-d); white-space: nowrap; user-select: none; -webkit-user-select: none; }
  .word { display: flex; }
  .ch {
    display: inline-block; font-variation-settings: 'wdth' var(--mono-wdth); transform-origin: 50% 100%;
    transition: font-variation-settings 1.1s var(--ease-out), opacity .6s ease, transform 1s var(--ease-out);
  }
  :global(.intro-done) .ch { transition: none; }
  :global(.pre) .ch { font-variation-settings: 'wdth' 62; opacity: 0; transform: translateY(18%); }
  .space { width: var(--mono-space); flex: none; }
  .tail { display: block; font-size: var(--step-lead); line-height: 1.35; font-weight: 700; text-transform: none; letter-spacing: 0; }
  @media (max-width: 640px) {
    .line { flex-direction: column; align-items: center; font-size: var(--mono-m); gap: .08em; }
    .space { display: none; }
  }
</style>
