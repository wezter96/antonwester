---
import Base from '../layouts/Base.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import type { Locale, PageRef } from '../content/routes';
import { ui } from '../content/ui';
import { headForAbout } from '../lib/seo';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = ui[locale].about;
const page: PageRef = { kind: 'about' };
---
<Base head={headForAbout(locale)}>
  <Nav locale={locale} page={page} standalone />
  <main id="main">
    <PageHero locale={locale} h1={c.h1} intro={c.intro} />
    <About locale={locale} />
  </main>
  <Footer locale={locale} page={page} />
</Base>

<script>
  import '../scripts/motion';
</script>
